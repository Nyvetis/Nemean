{
	"schemaVersion": 1,
	"id": "nemean",
	"version": "${version}",
	"name": "Nemean",
	"description": "Quality-of-life mod for Hypixel SkyBlock. Visual and informational features only.",
	"authors": ["Nyvetis"],
	"contact": {
    	"homepage": "https://github.com/Nyvetis/Nemean",
    	"sources": "https://github.com/Nyvetis/Nemean"
	},
	"license": "LGPL-2.1-or-later",
	"icon": "assets/nemean/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			{
				"value": "fr.nyvetis.nemean.Nemean",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "fr.nyvetis.nemean.client.NemeanClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"nemean.mixins.json",
		{
			"config": "nemean.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.14.2+kotlin.2.4.21"
	}
}
